const cheio = nome in CHEIOS;
---

<svg
  class:list={['icone', classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill={cheio ? 'currentColor' : 'none'}
  stroke={cheio ? undefined : 'currentColor'}
  stroke-width={cheio ? undefined : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={cheio ? CHEIOS[nome] : ICONES[nome]}
/>
